# --- LangSmith (recommended: traces every notebook run) ---
LANGSMITH_TRACING="true"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="<langsmith-api-key>"
LANGSMITH_PROJECT="modular-workshops-vertex"

# Only needed if you switch utils/models.py to the LangSmith Gateway block.
# Set to the same value as LANGSMITH_API_KEY.

# --- Model providers ---
# ANTHROPIC_API_KEY is always required: it runs the default model, and the web
# research tool (utils/search.py) uses Anthropic's web search whichever chat
# model the agent uses.
ANTHROPIC_API_KEY="<anthropic-api-key>"
# OPENAI_API_KEY="<openai-api-key>"

# Azure OpenAI (optional)
# AZURE_OPENAI_API_KEY="<azure-openai-api-key>"
# AZURE_OPENAI_ENDPOINT="<azure-openai-endpoint>"
# AZURE_OPENAI_API_VERSION=""

# AWS Bedrock (optional)
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION_NAME=""
# AWS_MODEL_ARN=""
